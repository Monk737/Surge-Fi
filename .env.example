# Copy this file to .env.local and fill in the values. Never commit .env.local.

# ─── Browser (NEXT_PUBLIC_ values are baked into the client bundle at build time) ──
# These are public by design. Run `npm run build` again after changing any of them.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here
# Deployed PositionFactory proxy. Live trading stays disabled while this is the zero address.
NEXT_PUBLIC_FACTORY_ADDRESS=0x0000000000000000000000000000000000000000
# Block the PositionFactory was deployed at. History and leaderboard scans start here.
NEXT_PUBLIC_DEPLOYMENT_BLOCK=0

# ─── Server (secret — read at runtime by /api/rpc, never sent to the browser) ──────
# Set ONE of these. RPC_URL wins if both are set.
RPC_URL=
ALCHEMY_KEY=your_alchemy_api_key_here
# Max /api/rpc requests per client IP per minute. 0 disables the limit. Default: 1200.
RPC_RATE_LIMIT_PER_MINUTE=1200

# ─── Smart Contracts (Hardhat — server-side only, NEVER expose) ───────────────
DEPLOYER_PRIVATE_KEY=0x_your_deployer_private_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here
COINMARKETCAP_KEY=your_coinmarketcap_key_for_gas_report
